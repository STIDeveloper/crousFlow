{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/project.md",
    ".opencode/rules/orchestration.md",
    "DESIGN.md"
  ],
  "default_agent": "main",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "tools": {
    "playwright_*": false
  }
}
