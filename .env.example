# Copier en .env puis remplacer les secrets (32 caractères minimum chacun) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="remplacer-par-une-chaine-aleatoire-de-64-caracteres-hexadecimaux"
QR_SECRET="remplacer-par-une-autre-chaine-aleatoire-de-64-caracteres-hexa"
# Optionnel : sans clé, l'IA utilise son explication calculée localement.
# Clé gratuite : https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optionnel : modèle Gemini (défaut : gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"
