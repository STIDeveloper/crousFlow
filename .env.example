# Copier en .env puis remplacer les secrets (32 caractères minimum chacun) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="remplacer-par-une-chaine-aleatoire-de-64-caracteres-hexadecimaux"
QR_SECRET="remplacer-par-une-autre-chaine-aleatoire-de-64-caracteres-hexa"
# Mets ta propre clé API Gemini (gratuite) : https://aistudio.google.com/apikey
# Optionnel : sans clé, l'IA utilise son explication calculée localement.
GOOGLE_GENERATIVE_AI_API_KEY="mets-ta-propre-cle-api-gemini"
# Optionnel : modèle Gemini (défaut : gemini-3.5-flash-lite, ~1 s par explication)
# GEMINI_MODEL="gemini-3.5-flash-lite"
